{
  "name": "@farert/typescript-examples",
  "version": "1.0.0",
  "description": "TypeScript integration examples for Farert WebAssembly Module - Japanese Railway Fare Calculation",
  "main": "dist/examples/basic-usage.js",
  "types": "dist/types/farert.d.ts",
  "scripts": {
    "build": "npm run clean && npm run build:prod",
    "build:dev": "tsc -p tsconfig.dev.json",
    "build:prod": "tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:all": "npm run build:dev && npm run build:prod && npm run build:types",

    "build:watch": "tsc -p tsconfig.dev.json --watch",
    "build:watch:prod": "tsc -p tsconfig.build.json --watch",
    "dev": "npm run build:watch",
    "watch": "npm run build:watch",

    "clean": "rimraf dist coverage docs/.vitepress/dist",
    "clean:dev": "rimraf dist/dev",
    "clean:prod": "rimraf dist/build",
    "clean:types": "rimraf dist/types",
    "clean:all": "npm run clean && rimraf node_modules/.cache",

    "prebuild": "npm run clean && npm run type-check",
    "postbuild": "npm run copy-assets && npm run validate:build",
    "copy-assets": "copyfiles -u 1 \"types/**/*.md\" \"examples/**/*.md\" \"README.md\" dist/",

    "type-check": "tsc --noEmit --pretty",
    "type-check:dev": "tsc -p tsconfig.dev.json --noEmit --pretty",
    "type-check:prod": "tsc -p tsconfig.build.json --noEmit --pretty",
    "type-check:watch": "tsc --noEmit --watch --pretty",
    "type-check:all": "npm run type-check:dev && npm run type-check:prod",

    "compile": "tsc --noEmit",
    "compile:watch": "tsc --noEmit --watch",
    "validate:build": "node -e \"console.log('Build validation: Checking output files...'); require('fs').statSync('./dist/build'); console.log('✓ Build successful')\"",
    "validate:types": "npm run type-check:all && echo '✓ All TypeScript configurations pass'",

    "type-check:strict": "npx tsc -p tsconfig.strict.json --noEmit --pretty",
    "build:strict": "npx tsc -p tsconfig.strict.json",
    "validate:strict": "npm run type-check:strict && echo '✓ Strict TypeScript configuration passes with zero errors'",
    "test:all-configs": "npm run type-check:strict && npm run build:strict && npm run clean:strict && echo '✓ All TypeScript configurations validated successfully'",
    "clean:strict": "rimraf dist/strict",

    "example:basic": "node dist/examples/basic-usage.js",
    "example:type-safety": "node dist/examples/type-safety-demo.js",
    "example:async": "node dist/examples/async-patterns.js",
    "example:all": "npm run example:basic && npm run example:type-safety && npm run example:async",

    "dev": "ts-node examples/basic-usage.ts",
    "dev:basic": "ts-node examples/basic-usage.ts",
    "dev:type-safety": "ts-node examples/type-safety-demo.ts",
    "dev:async": "ts-node examples/async-patterns.ts",

    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",

    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:types": "npm run type-check",

    "docs": "typedoc",
    "docs:serve": "typedoc --watch",

    "validate": "npm run type-check && npm run lint && npm run format:check",
    "precommit": "npm run validate && npm run test",

    "start": "npm run build && npm run example:basic",
    "demo": "npm run build && npm run example:all"
  },

  "keywords": [
    "typescript",
    "webassembly",
    "wasm",
    "japanese",
    "railway",
    "fare",
    "calculation",
    "examples",
    "integration",
    "type-safety",
    "async",
    "promises"
  ],

  "author": "Farert Project",
  "license": "GPL-3.0",

  "repository": {
    "type": "git",
    "url": "https://github.com/farert/farert-wasm.git",
    "directory": "examples/api/typescript"
  },

  "bugs": {
    "url": "https://github.com/farert/farert-wasm/issues"
  },

  "homepage": "https://github.com/farert/farert-wasm#readme",

  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },

  "dependencies": {},

  "devDependencies": {
    "@types/node": "^18.0.0",

    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "tslib": "^2.6.0",

    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.0",

    "prettier": "^3.0.0",

    "jest": "^29.6.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0",

    "typedoc": "^0.25.0",
    "typedoc-plugin-markdown": "^3.16.0",

    "rimraf": "^5.0.0",
    "copyfiles": "^2.4.0",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.0"
  },

  "peerDependencies": {
    "@farert/wasm": "*"
  },

  "peerDependenciesMeta": {
    "@farert/wasm": {
      "optional": false
    }
  },

  "files": [
    "dist/**/*",
    "types/**/*",
    "examples/**/*",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md"
  ],

  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },

  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/examples", "<rootDir>/types"],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "examples/**/*.ts",
      "types/**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"]
  },

  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint",
      "import",
      "node",
      "promise"
    ],
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended",
      "@typescript-eslint/recommended-requiring-type-checking",
      "plugin:import/recommended",
      "plugin:import/typescript",
      "plugin:node/recommended",
      "plugin:promise/recommended",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module",
      "project": "./tsconfig.json"
    },
    "rules": {
      "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
      "@typescript-eslint/explicit-function-return-type": "warn",
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/prefer-readonly": "error",
      "@typescript-eslint/prefer-nullish-coalescing": "error",
      "@typescript-eslint/prefer-optional-chain": "error",
      "import/order": ["error", { "groups": [["builtin", "external", "internal"]] }],
      "node/no-missing-import": "off",
      "node/no-unsupported-features/es-syntax": "off"
    },
    "settings": {
      "import/resolver": {
        "typescript": {
          "alwaysTryTypes": true,
          "project": "./tsconfig.json"
        }
      }
    }
  },

  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,
    "quoteProps": "as-needed",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "auto"
  },

  "typedoc": {
    "entryPoints": [
      "types/farert.d.ts",
      "examples/basic-usage.ts",
      "examples/type-safety-demo.ts",
      "examples/async-patterns.ts"
    ],
    "out": "docs",
    "plugin": ["typedoc-plugin-markdown"],
    "theme": "markdown",
    "readme": "README.md",
    "exclude": [
      "**/node_modules/**",
      "**/dist/**"
    ],
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "categorizeByGroup": true,
    "defaultCategory": "Other",
    "categoryOrder": [
      "Core Types",
      "Station Types",
      "Line Types",
      "Route Types",
      "Fare Types",
      "Examples",
      "*"
    ]
  },

  "browserslist": [
    "node >= 14",
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}