{
  // === Type Declaration Generation Configuration ===
  "extends": "./tsconfig.json",

  "compilerOptions": {
    // === Type Declaration Focus ===
    "emitDeclarationOnly": true,                 // Only emit .d.ts files
    "declaration": true,                         // Generate .d.ts files
    "declarationMap": true,                      // Generate declaration map files
    "composite": true,                           // Enable project references

    // === Output Configuration ===
    "outDir": "./dist/types",                    // Type declaration output
    "rootDir": "./",                             // Root for type declarations

    // === Type Checking (Strict for Types) ===
    "strict": true,                              // Strict mode for type generation
    "noImplicitAny": true,                       // No implicit any in types
    "exactOptionalPropertyTypes": true,          // Exact optional property types
    "noImplicitReturns": true,                   // All paths must return
    "noUnusedLocals": true,                      // No unused locals in type files
    "noUnusedParameters": true,                  // No unused parameters in type files

    // === Module Resolution for Types ===
    "moduleResolution": "node",                  // Node resolution for types
    "esModuleInterop": true,                     // ES module interop
    "allowSyntheticDefaultImports": true,        // Synthetic default imports

    // === Skip Checks for Performance ===
    "skipLibCheck": true,                        // Skip lib type checking
    "skipDefaultLibCheck": true,                 // Skip default lib checking

    // === Build Info ===
    "incremental": true,                         // Incremental type compilation
    "tsBuildInfoFile": "./dist/types/.tsbuildinfo" // Type build info
  },

  // === Type Declaration Sources ===
  "include": [
    "types/**/*",
    "typescript-integration.ts"
  ],

  // === Exclude Non-Type Sources ===
  "exclude": [
    "node_modules",
    "dist",
    "examples/**/*",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.js"
  ]
}