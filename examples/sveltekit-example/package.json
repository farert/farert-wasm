{
  "name": "farert-sveltekit-example",
  "version": "1.0.0",
  "description": "Comprehensive SvelteKit example application demonstrating the Farert WebAssembly SDK",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.35.1",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.1.2",
    "svelte": "^5.0.0",
    "svelte-check": "^3.6.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "lucide-svelte": "^0.400.0"
  },
  "keywords": [
    "farert",
    "sveltekit",
    "webassembly",
    "railway",
    "fare-calculation",
    "japanese-railway",
    "sdk-example"
  ],
  "author": "Farert WebAssembly Project",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/farert/farert-wasm",
    "directory": "examples/sveltekit-example"
  }
}