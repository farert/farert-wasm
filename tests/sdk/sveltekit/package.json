{
  "name": "@farert/sveltekit-integration-tests",
  "version": "1.0.0",
  "description": "SvelteKit integration tests for Farert WebAssembly SDK",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest run --inspect-brk",
    "test:sveltekit-ssr": "vitest run --grep=\"SSR\"",
    "test:sveltekit-static": "vitest run --grep=\"Static\"",
    "test:sveltekit-hydration": "vitest run --grep=\"Hydration\"",
    "test:sveltekit-performance": "vitest run --grep=\"Performance\"",
    "test:sveltekit-fallbacks": "vitest run --grep=\"Fallback\"",
    "clean": "rm -rf coverage .vitest dist"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.10.0",
    "@vitest/ui": "^1.0.4",
    "jsdom": "^23.0.1",
    "vitest": "^1.0.4"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^1.0.0",
    "svelte": "^4.0.0"
  },
  "keywords": [
    "sveltekit",
    "integration-tests",
    "ssr",
    "static-generation",
    "hydration",
    "webassembly",
    "farert",
    "railway",
    "fare-calculation"
  ],
  "author": "Farert WebAssembly Project",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/farert/farert-wasm.git",
    "directory": "tests/sdk/sveltekit"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}