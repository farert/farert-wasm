{
  "name": "farert-wasm",
  "version": "2.0.0",
  "description": "Japanese railway fare calculation system fully ported to WebAssembly with 39 APIs",
  "main": "dist/farert.js",
  "scripts": {
    "build": "source setup_env.sh && make",
    "clean": "make clean",
    "serve": "make serve",
    "dev": "source setup_env.sh && make && make serve",
    "setup": "source setup_env.sh",
    "test": "node test_simple.js",
    "test:unit": "node tests/run_tests.js",
    "test:simple": "node test_simple.js",
    "test:database": "node tests/run_tests.js database",
    "test:route": "node tests/run_tests.js route",
    "test:fare": "node tests/run_tests.js fare",
    "test:integration": "node tests/run_tests.js integration",
    "test:browser": "echo 'Open http://localhost:8080/test_unit.html in browser after running: npm run serve'",
    "cli:build": "tsc",
    "cli:exec": "npm run cli:build && node dist/cli/cli/main.js -exec",
    "cli": "npm run cli:build && node dist/cli/cli/main.js",
    "cli:test-original": "npm run cli:exec",
    "cli:test-extended": "npm run cli:build && node dist/cli/cli/test_wasm_extended.js",
    "cli:test-all": "npm run cli:build && node dist/cli/cli/test_integration.js"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "railway",
    "fare-calculation",
    "japanese-railway",
    "emscripten",
    "c++",
    "sqlite",
    "transport"
  ],
  "author": "Farert Development Team",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "commander": "^11.0.0"
  },
  "dependencies": {
    "commander": "^11.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}