{
  "name": "farert-wasm",
  "version": "0.1.0",
  "description": "FARERT WebAssembly binding for C++20 to WASM compilation with TypeScript interfaces",
  "main": "dist/farert.js",
  "types": "dist/farert.d.ts",
  "files": [
    "dist/**/*",
    "src/ts/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build.sh",
    "build:ts": "tsc",
    "build": "npm run build:wasm && npm run build:ts",
    "test": "jest",
    "clean": "rm -rf dist build node_modules",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "emscripten",
    "typescript",
    "farert",
    "pwa",
    "sqlite"
  ],
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/farert/farert-wasm.git"
  }
}
