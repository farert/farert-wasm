# NPM Publishing Configuration for farert-wasm

# Registry configuration
registry=https://registry.npmjs.org/

# Package access settings
access=public

# Publishing preferences  
save-exact=true
package-lock=true

# Security settings
audit-level=moderate

# Build settings
engine-strict=true

# Documentation
fund=false

# Publishing workflow
publish-config-registry=https://registry.npmjs.org/

# Development settings
prefer-offline=false
cache-min=86400

# CI/CD friendly settings
progress=false
loglevel=warn