# NPM Publishing Configuration for farert-wasm

# Registry configuration
registry=https://registry.npmjs.org/

# Package access settings
access=public

# Publishing preferences  
save-exact=true
package-lock=true

# Security settings
audit-level=moderate

# Build settings
engine-strict=true

# Documentation
fund=false

# Development settings
prefer-offline=false
# Removed deprecated cache-min setting (replaced by prefer-offline)

# CI/CD friendly settings
progress=false
loglevel=warn

# Prevent npm from interpreting CLI numeric arguments as config
ignore-scripts=false